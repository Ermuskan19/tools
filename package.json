{
  "name": "zegnite-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "npm run -w apps/main dev",
    "dev:pdf": "npm run -w apps/pdf dev",
    "dev:security": "npm run -w apps/security dev",
    "dev:calc": "npm run -w apps/calc dev",
    "dev:qr": "npm run -w apps/qr dev",
    "dev:dev": "npm run -w apps/dev dev",
    "dev:img": "npm run -w apps/img dev",
    "dev:social": "npm run -w apps/social dev",
    "build:main": "npm run -w apps/main build",
    "build:pdf": "npm run -w apps/pdf build",
    "build:security": "npm run -w apps/security build",
    "build:calc": "npm run -w apps/calc build",
    "build:qr": "npm run -w apps/qr build",
    "build:dev": "npm run -w apps/dev build",
    "build:img": "npm run -w apps/img build",
    "build:social": "npm run -w apps/social build",
    "build:all": "npm run build:main && npm run build:pdf && npm run build:security && npm run build:calc && npm run build:dev && npm run build:img && npm run build:qr && npm run build:social",
    "lint": "eslint .",
    "preview": "vite preview --config apps/main/vite.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.21.0"
  }
}
